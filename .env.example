# Chave de API da Comunidade RDT (fornecida pelo rdtresenhadatorcida.com.br)
# Usada apenas no servidor (funções em /api) — nunca exposta ao navegador.
RDT_COMMUNITY_API_KEY=

# Senha de administrador (compartilhada entre o botão "Compartilhar na
# Comunidade RDT" e o painel /admin de criação/edição/exclusão de matérias)
RDT_ADMIN_PASSWORD=

# Upstash Redis (Vercel Marketplace → Storage → Upstash) — guarda as
# matérias do portal RDT criadas pelo painel /admin. Os nomes exatos
# dependem do "Custom Prefix" escolhido ao conectar o banco ao projeto.
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=
